# Groq AI API Key (required for Orbit, Pulsar, and Quasar models)
GROQ_API_KEY=

# Search API Key (Tavily or Brave Search for live competitor and shutdown grounding)
SEARCH_API_KEY=

# Optional Cloud SQL / PostgreSQL configuration (defaults to in-memory store if unset)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# Admin & Owner Accounts
ADMIN_EMAIL=
OWNER_EMAIL=

# Razorpay Subscriptions & Webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_ULTRA=
RAZORPAY_WEBHOOK_SECRET=

# Web Push Notifications (VAPID)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

# AI Teammates External Provider Keys (optional BYOK)
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=